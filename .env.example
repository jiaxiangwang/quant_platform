KB_KNOWLEDGE_DIR=./knowledge
KB_VECTOR_BACKEND=memory
KB_EMBEDDING_BACKEND=hashing
KB_RERANKER_BACKEND=lexical
KB_HYBRID_ALPHA=0.55
KB_RERANK_WEIGHT=0.45
KB_RETRIEVE_K=20
KB_QDRANT_URL=http://qdrant:6333
